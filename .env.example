# Docker Compose defaults. Copy to .env if you want to override.
# Host Python/Node are not required.

POSTGRES_USER=snowball
POSTGRES_PASSWORD=snowball
POSTGRES_DB=snowball

# Leave empty to generate and persist data/secret.key inside the data volume.
SNOWBALL_SECRET_KEY=

LOG_LEVEL=INFO

# Host port for the web UI (loopback only).
SNOWBALL_HTTP_PORT=8080

# Optional. Prefills first-run setup so you only confirm and enter the login code.
# Create an app at https://my.telegram.org → API development tools.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+15551234567

# docker-compose.override.yml serves the UI with Vite HMR.
# To use the static nginx client instead:
# COMPOSE_FILE=docker-compose.yml

# Embed sidecar is internal (compose DNS http://embed:8001).
# Override only if you run the sidecar on the host.
# SNOWBALL_EMBED_URL=http://127.0.0.1:8001

# Optional. Only needed if catalog images use s3:// URIs instead of local files.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-2
